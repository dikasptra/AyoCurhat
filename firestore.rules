rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper Functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Sessions Validation
    function isValidSession(data) {
      return data.userId is string && data.userId == request.auth.uid &&
             data.title is string && data.title.size() <= 100 &&
             data.messages is list && data.messages.size() <= 1000 &&
             data.createdAt is timestamp &&
             data.updatedAt is timestamp;
    }

    match /sessions/{sessionId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidSession(incoming());
      allow update: if isSignedIn() && existing().userId == request.auth.uid && isValidSession(incoming());
      allow delete: if isSignedIn() && existing().userId == request.auth.uid;
    }

    // User Profiles
    function isValidUser(data) {
      return data.keys().hasAll(['displayName', 'email']) &&
             data.displayName is string &&
             data.email is string &&
             (!('currentStreak' in data) || data.currentStreak is number) &&
             (!('lastChatDate' in data) || data.lastChatDate is string) &&
             (!('lastPepTalk' in data) || data.lastPepTalk is string) &&
             (!('lastPepTalkDate' in data) || data.lastPepTalkDate is string);
    }

    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create, update: if isOwner(userId) && isValidUser(incoming());
    }
    // Mood History Validation
    function isValidMood(data) {
      return data.userId is string && data.userId == request.auth.uid &&
             data.date is string &&
             data.mood is string &&
             data.timestamp is timestamp &&
             data.streak is number;
    }

    match /mood_history/{moodId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidMood(incoming());
      allow update: if isSignedIn() && existing().userId == request.auth.uid && isValidMood(incoming());
      allow delete: if isSignedIn() && existing().userId == request.auth.uid;
    }

    // Feedback Validation
    function isValidFeedback(data) {
      return data.userId == request.auth.uid &&
             data.text is string && data.text.size() > 0 &&
             data.timestamp == request.time;
    }

    match /feedback/{feedbackId} {
      // Typically, users don't need to read feedback. If they do, they can read their own.
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidFeedback(incoming());
      // No updates or deletes allowed for feedback
    }
  }
}
